#include <stdio.h>
#include <string.h>
int main() {
    
    char nome[50];
   
    printf("Digite seu nome completo: ");
    fgets(nome, sizeof(nome), stdin);
   
    printf("\nOlá, %s.", nome); // inclui o \n digitado
    nome[strcspn(nome, "\n")] = '\0'; // remove o \n
   
    printf("\nOlá, %s.", nome);
return 0;
}
