#include <stdio.h>

int main(){
    
    int m[2][4], s = 0, i, j; // m = matriz, s = soma
    
   for(i = 0; i < 3; i ++){
         for(j = 0; j < 4; j ++){
        printf("m[%d][%d]: ", i, j);
        scanf("%d", &m[i][j]);
     }
    }
    for(i = 0; i < 3; i ++){
         for(j = 0; j < 4; j ++){
            s = s + m[i][j];
            printf("m[%d][%d]: %d\n",m[i][j]);
     }
    }
    
     printf("Soma: %d\n", s);

    return 0;
}Matriz armazenar em Linhas e colunas /
