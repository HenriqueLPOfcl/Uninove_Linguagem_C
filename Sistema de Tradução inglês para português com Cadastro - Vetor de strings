#include <stdio.h>
#include <string.h>
int main () {
    char ingles[5][30], portugues[5][30], palavra[30];
    int contador=0, i, opcao;
   
    do{
        printf("########### Sistema de tradução ###########\n");
        printf("   -> 1 - Cadastrar \n");
        printf("   -> 2 - Consultar \n");
        printf("   -> 0 - Sair \n");
        printf(" Digite a sua opção: ");
        scanf("%d", &opcao);
        getchar();
        switch(opcao){
            case 1:
                    printf ("Digite palavra em inglês: ");
                    fgets(ingles[contador], sizeof(ingles[contador]), stdin);
                    ingles[contador][strcspn(ingles[contador], "\n")] = '\0';
                    printf ("Digite a tradução para o português: ");
                    fgets(portugues[contador], sizeof(portugues[contador]), stdin);
                    portugues[contador][strcspn(portugues[contador], "\n")] = '\0';
                    contador++;
                    break;
            case 2:
                    printf ("\nDigite uma palavra em inglês para saber a tradução para o português:\n");
                    fgets(palavra, sizeof(palavra), stdin);
                    palavra[strcspn(palavra, "\n")] = '\0';
                    for (i = 0; i < contador; i++) {
                        if ( strcmp(ingles[i], palavra) == 0 ){
                            printf ("\nPalavra em português: %s \n\n", portugues[i]);
                        }
                    }
                    break;
            case 0:
                    printf("\n\n Obrigado por utilizar o sistema!\n\n");
                    break;
            default:
                     printf("\n\n Código inválido!\n\n");
        }
    }while(opcao != 0);
    return 0;
}
